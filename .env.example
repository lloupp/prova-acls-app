# Variáveis do backend (Cloudflare Worker) — NÃO commitar valores reais.
# Configure os secrets com: npx wrangler secret put NOME

# Destinatário das respostas (email da professora)
PROFESSORA_EMAIL=professora@exemplo.com

# Remetente verificado no provedor de email
FROM_EMAIL=prova@prova-acls.pages.dev

# Provedor: "brevo" (padrão) ou "mailchannels"
EMAIL_PROVIDER=brevo

# Chave da API Brevo (https://app.brevo.com) — obrigatória se EMAIL_PROVIDER=brevo
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxx
